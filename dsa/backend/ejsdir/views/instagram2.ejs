<%- include("includes/common.ejs") %>   
<!-- include means sub template , common.ejs ka code hai woh idar use ho jayega -->
<!-- common.ejs file  hai isse maine includes folder mein create kya hai and includes folder ko views folder mein create kya hai-->
 <!-- include("/includes/common.ejs")  esse nhi lik sakta-->
<body>
    <h1>This page is belongs to @ <%= data.name %> </h1>  <!-- in browser localhost:8080 /cats kiya toh instagram ke data mein search hoga ki cats name ka object hai kya agar hai toh woh object data mein chala jayega and now we want data.name means cats object ka name that is cats --> 
    <button> LIke </button> <button> Subscribe</button>

    <p>
        Followers : <%= data.followers %>  &nbsp;&nbsp;&nbsp;  Following : <%= data.following %>  <!--data.following  means cats object mein following par jake uske value return karuga -->
    </p>
    <hr/>  <!-- give doted horizontal line -->

    <%  for(let post of data.posts) {  %> 
        <img src = "<%=post.image%>" alt = "some img" > 
        <p>
            Like : <%= post.likes %>  &nbsp;&nbsp;&nbsp;  Comments : <%= post.comments %>
        </p>
    <hr/>
  <%  } %>
   
  <%- include("includes/footer.ejs") %>
</body>
<script src="/app.js"></script>
</html> 